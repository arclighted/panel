URL="http://localhost:3000"
PORT=3000
# Public port served by the TanStack Start frontend (arclight-web).
# Single-process panel: the Nitro (TanStack) server listens on PORT directly.
# PANEL_INTERNAL_PORT is legacy (pre-Phase 5 Express seam) and ignored.
NAME="Arclight"
DATABASE_URL="file:./storage/dev.db"
NODE_ENV="development"
# Generate a production value with: openssl rand -hex 32
SESSION_SECRET="change_me"
# Defaults used by "Auto-generate database host" on the admin Databases page.
# Leave unset to fall back to 127.0.0.1:3306 with user "root" and no password.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
