{
  "name": "Arclight",
  "version": "2.5.193",
  "description": "Arclight panel, A simple-to-use game server management panel",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arclighted/panel"
  },
  "author": "radityprtama",
  "license": "MIT",
  "scripts": {
    "setup": "pnpm install && prisma generate && prisma db push && pnpm run build",
    "start": "bun src/tui/index.ts",
    "start:panel": "pnpm --filter arclight-web start",
    "dev": "node scripts/dev.mjs",
    "build": "tsc && tsc -p tsconfig.prisma.json && tailwindcss -i ./public/tw.css -o ./public/styles.css",
    "build:css": "tailwindcss -i ./public/tw.css -o ./public/styles.css --watch",
    "migrate:dev": "prisma migrate dev",
    "dev:web": "pnpm --filter arclight-web dev",
    "build:web": "pnpm --filter arclight-web build",
    "start:web": "pnpm --filter arclight-web start",
    "typecheck:web": "pnpm --filter arclight-web typecheck",
    "test:web": "pnpm --filter arclight-web test",
    "generate-routes": "pnpm --filter arclight-web generate-routes",
    "migrate:deploy": "prisma migrate deploy && prisma generate",
    "generate": "prisma generate",
    "lint": "eslint src --fix",
    "format": "prettier --write src/",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.prisma.json --noEmit && tsc -p tsconfig.tui.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret": "node dist/cli/secret.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/lib-storage": "^3.1100.0",
    "@dicebear/core": "^9.4.3",
    "@dicebear/thumbs": "^9.4.2",
    "@opentui/core": "^0.4.5",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.10.1",
    "consola": "^3.4.2",
    "cron-parser": "^5.6.2",
    "csrf-csrf": "^4.0.3",
    "express": "^5.2.1",
    "dotenv": "^17.4.2",
    "lucide": "^1.18.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.3",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "validator": "^13.15.35",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.14",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10",
    "@types/express-session": "^1.19.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}
